# ===========================================================================
# PUBLIC client configuration — VITE_* are inlined into the PUBLIC JS bundle.
# Only NON-SECRET values belong here.
# ===========================================================================

# Supabase — public by design (protected by Row Level Security). Optional for
# demo mode; required only for CRM data persistence.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional public feature flags
VITE_GMAIL_ENABLED=true
VITE_GOOGLE_CALENDAR_ENABLED=true
VITE_SLACK_ENABLED=true

# Development Mode — 'true' forces demo mode; leave 'false' in production.
VITE_DEVELOPMENT_MODE=false

# ===========================================================================
# PRIVATE provider credentials — DO NOT use VITE_* for these. A VITE_* key is
# compiled into the public bundle and is readable by anyone.
#
# Set them as SERVER-side Netlify environment variables instead
# (Netlify dashboard > Site configuration > Environment & secrets > Variables).
# They are read ONLY by netlify/functions (process.env.*), never the browser.
# ===========================================================================
# OPENAI_API_KEY=...        (server-side; powers /api/llm, OpenAI)
# GEMINI_API_KEY=...        (server-side; powers /api/llm, Gemini)
# ELEVENLABS_API_KEY=...    (server-side; optional voice)
# COMPOSIO_API_KEY=...      (server-side; optional tool integrations)
