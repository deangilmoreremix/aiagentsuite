# OpenAI API Key - Get this from https://platform.openai.com/api-keys
# This powers the OpenAI Agents SDK runtime (see https://platform.openai.com/docs/guides/agents).
VITE_OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model override (optional) - Defaults to gpt-4o.
# Override the agent model, e.g. VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_MODEL=gpt-4o

# OpenAI reasoning model override (optional) - Defaults to gpt-4o.
# VITE_OPENAI_REASONING_MODEL=gpt-4o

# OpenAI MCP Server (optional)
# Remote MCP server (SSE) exposed to the agents via the Agents SDK `mcpServers` option.
# When VITE_MCP_SERVER_URL is set, the external-action tools (send_email,
# create_calendar_event, send_slack_message) are NO LONGER registered locally -
# they are fulfilled by the MCP server's tools instead. Leave it empty to keep
# using the built-in local tools that record the action as a CRM activity.
# VITE_MCP_SERVER_TOKEN is sent as an `Authorization: Bearer <token>` header.
VITE_MCP_SERVER_URL=
VITE_MCP_SERVER_NAME=openai-mcp
VITE_MCP_SERVER_TOKEN=

# ElevenLabs API Key (for voice features) - Get this from https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Supabase Configuration (for CRM data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini API Key (optional alternative LLM) - Get this from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Development Mode - Set to 'false' for production with real APIs
VITE_DEVELOPMENT_MODE=false
