# OpenAI API Key - Get this from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Composio API Key - Get this from https://app.composio.dev/
VITE_COMPOSIO_API_KEY=your_composio_api_key_here

# ElevenLabs API Key (for voice features) - Get this from https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Supabase Configuration (for CRM data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gmail Integration (via Composio)
VITE_GMAIL_ENABLED=true

# Calendar Integration (via Composio)  
VITE_GOOGLE_CALENDAR_ENABLED=true

# Slack Integration (via Composio)
VITE_SLACK_ENABLED=true

# Development Mode - Set to 'false' for production with real APIs
VITE_DEVELOPMENT_MODE=false
VITE_GEMINI_API_KEY=your_gemini_api_key_here
